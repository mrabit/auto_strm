{
  "remote": {
    "url": "https://your-server.com/dav",
    "username": "your-account",
    "password": "your-password",
    "publicUrl": ""
  },
  "cron": "0 */6 * * *",
  "rateLimit": {
    "concurrency": 5,
    "intervalMs": 200
  },
  "jellyfin": {
    "url": "http://your-jellyfin:8096",
    "token": "your-api-token"
  },
  "tasks": [
    {
      "name": "example",
      "enabled": true,
      "remote": {
        "path": "/cloud-drive/Media",
        "syncMetadata": true
      },
      "local": {
        "path": "/data/example"
      },
      "cron": "0 */6 * * *",
      "rateLimit": {
        "concurrency": 3,
        "intervalMs": 500
      },
      "jellyfin": {
        "url": "http://another-jellyfin:8096",
        "token": "another-token"
      }
    }
  ]
}
