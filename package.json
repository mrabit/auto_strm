{
  "name": "auto_strm",
  "version": "2.0.0",
  "description": "Sync media metadata from WebDAV and generate .strm links for video files",
  "main": "src/index.ts",
  "scripts": {
    "dev": "WEB_PORT=3000 NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "check": "npm run lint && tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "concurrently -k -n api,ui -c cyan,green \"WEB_PORT=3000 NODE_ENV=development tsx watch src/index.ts\" \"cd web && npx vite\"",
    "build:web": "cd web && npm ci && npm run build",
    "build:all": "npm run build && npm run build:web",
    "prepare": "husky"
  },
  "dependencies": {
    "cron": "^3.1.0",
    "express": "^5.2.1",
    "webdav": "^5.7.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "web/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tsx": "^4.0.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.0"
  }
}
